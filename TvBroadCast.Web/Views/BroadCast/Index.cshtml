
@model List<TvBroadCast.Domain.Entities.BroadCast>

@{
    var windowStart = (DateTime)ViewBag.WindowStart;
    var windowEnd = (DateTime)ViewBag.WindowEnd;
    var slotMinutes = 30;
    var totalSlots = (int)((windowEnd - windowStart).TotalMinutes / slotMinutes);
    var slotTimes = Enumerable.Range(0, totalSlots + 1)
        .Select(i => windowStart.AddMinutes(i * slotMinutes))
        .ToList();
    bool isScheduler = User.IsInRole("Scheduler");
    bool isApprover = User.IsInRole("Approver");
}

<h2>Schedule - Next 4.5 Hours</h2>

<div>
    <button id="refreshBtn" class="btn btn-secondary btn-sm">Refresh</button>
</div>
<table id="schedule-table" class="table table-bordered">
    <thead>
        <tr>
            <th>Broadcast Name</th>
            @foreach (var slot in slotTimes)
            {
                <th>@slot.ToShortTimeString()</th>
            }
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var broadcast in Model)
        {
            <tr data-broadcastid="@broadcast.Id">
                <td>@broadcast.Title</td>
                @foreach (var slot in slotTimes)
                {
                    bool inRange = broadcast.StartTime <= slot && broadcast.EndTime > slot;
                    <td class="@(inRange ? "bg-info" : "")"></td>
                }
                <td>
                    <span class="badge @(broadcast.Status == TvBroadCast.Domain.Entities.BroadCastStatus.BStatus.Approved ? "bg-success" : broadcast.Status == TvBroadCast.Domain.Entities.BroadCastStatus.BStatus.Pending ? "bg-warning" : "bg-danger")">
                        @broadcast.Status
                    </span>
                </td>
                <td>
                    @if (isScheduler)
                    {
                        <button class="btn btn-sm btn-primary edit-broadcast-btn">Edit</button>
                        <button class="btn btn-sm btn-danger delete-broadcast-btn">Delete</button>
                    }
                    @if (isApprover && broadcast.Status == TvBroadCast.Domain.Entities.BroadCastStatus.BStatus.Pending)
                    {
                        <button class="btn btn-sm btn-success approve-broadcast-btn">Approve</button>
                        <button class="btn btn-sm btn-danger reject-broadcast-btn">Reject</button>
                    }
                    <button class="btn btn-sm btn-info history-broadcast-btn">History</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modals for Add/Edit/Approve/Reject/History will be here -->
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function() {
            // Refresh schedule table
            $("#refreshBtn").on("click", function () {
                var windowStart = "@windowStart.ToString("o")";
                var windowEnd = "@windowEnd.ToString("o")";
                $.get("@Url.Action("GetSchedule", "Broadcast")", { windowStart, windowEnd }, function(data) {
                    $("#schedule-table tbody").html($(data).find("tbody").html());
                });
            });

            // Add, Edit, Delete, Approve, Reject, History logic using AJAX
            // You would implement modal dialogs and AJAX POSTs to the respective controller endpoints
            // For example:
            $(".delete-broadcast-btn").on("click", function() {
                if (!confirm("Delete broadcast?")) return;
                var id = $(this).closest("tr").data("broadcastid");
                $.ajax({
                    url: '@Url.Action("Delete", "Broadcast")',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(id),
                    success: function() {
                        $("#refreshBtn").click();
                    },
                    error: function(xhr) {
                        alert(xhr.responseJSON.error);
                    }
                });
            });

            // Similarly, implement AJAX for Edit, Approve, Reject, History

            // Optionally, use setInterval for auto-refresh
            // setInterval(function(){ $("#refreshBtn").click(); }, 180000);
        });
    </script>
}