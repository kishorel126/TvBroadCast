@model TvBroadCast.Domain.Entities.BroadCast
@{
    ViewBag.Title = "Review Broadcast";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Review Broadcast</h2>

    <div id="result-message" class="mb-3"></div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">@Model.Title</h4>
        </div>
        <div class="card-body">
            <p><strong>Description:</strong> @Model.Description</p>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <p><strong>Start:</strong> @Model.StartTime.ToString("f")</p>
                </div>
                <div class="col-md-6 mb-2">
                    <p><strong>End:</strong> @Model.EndTime.ToString("f")</p>
                </div>
                <div class="col-md-6 mb-2">
                    <p><strong>Status:</strong> 
                        <span class="badge @GetStatusBadgeClass(Model.Status)">
                            @Model.Status
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <form id="review-form" class="mt-4">
        <input type="hidden" name="BroadcastId" value="@Model.Id" />
        <div class="mb-3">
            <label for="Comment" class="form-label">Approver Comment <small class="text-muted">(optional)</small>:</label>
            <input type="text" name="Comment" class="form-control" placeholder="Add your review comment" />
        </div>

        @if (Model.Status == TvBroadCast.Domain.Entities.BroadCastStatus.BStatus.Pending)
        {
            <div class="d-flex flex-wrap gap-2">
                <button type="button" id="approve-btn" class="btn btn-success px-4">Approve</button>
                <button type="button" id="reject-btn" class="btn btn-danger px-4">Reject</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-auto">Back to List</a>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3">
                This broadcast has already been <strong>@Model.Status.ToString().ToLower()</strong>.
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary mt-2">Back to List</a>
        }
    </form>
</div>

@functions {
    string GetStatusBadgeClass(TvBroadCast.Domain.Entities.BroadCastStatus.BStatus status)
    {
        return status switch
        {
            TvBroadCast.Domain.Entities.BroadCastStatus.BStatus.Pending => "bg-warning text-dark",
            TvBroadCast.Domain.Entities.BroadCastStatus.BStatus.Approved => "bg-success",
            TvBroadCast.Domain.Entities.BroadCastStatus.BStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/broadcastHub")
            .withAutomaticReconnect()
            .build();

        connection.start()
            .then(() => console.log("Connected to SignalR in Review view"))
            .catch(err => console.error("SignalR connection error: ", err));

        function submitReview(action) {
            var data = {
                BroadcastId: $("input[name='BroadcastId']").val(),
                Comment: $("input[name='Comment']").val()
            };

            $.ajax({
                url: action === "approve" ? '@Url.Action("Approve", "Approver")' : '@Url.Action("Reject", "Approver")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (res) {
                    if (res.success) {
                        $("#result-message").html('<div class="alert alert-success">Broadcast ' + (action === "approve" ? 'approved' : 'rejected') + ' successfully.</div>');

                        connection.invoke("NotifyBroadcastUpdated")
                            .then(() => console.log("Broadcast update sent to clients."))
                            .catch(err => console.error("SignalR invoke error:", err));

                        setTimeout(function () {
                            window.location.href = '@Url.Action("Index", "Approver")';
                        }, 1200);
                    } else {
                        $("#result-message").html('<div class="alert alert-danger">' + (res.error || 'Error occurred') + '</div>');
                    }
                },
                error: function () {
                    $("#result-message").html('<div class="alert alert-danger">Server error occurred.</div>');
                }
            });
        }

        $("#approve-btn").click(function () { submitReview("approve"); });
        $("#reject-btn").click(function () { submitReview("reject"); });
    </script>
}
