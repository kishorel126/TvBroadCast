@model TvBroadCast.Domain.Entities.BroadCast
@{
    ViewBag.Title = "Review Broadcast";
}
<h2>Review: @Model.Title</h2>
<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Time:</strong> @Model.StartTime - @Model.EndTime</p>
<form asp-action="Approve" method="post" class="mb-2">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="form-group">
        <label>Approval Comment:</label>
        <input type="text" name="comment" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Approve</button>
</form>
<form asp-action="Reject" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="form-group">
        <label>Rejection Comment:</label>
        <input type="text" name="comment" class="form-control" />
    </div>
    <button type="submit" class="btn btn-danger">Reject</button>
</form>
<a asp-action="Index" class="btn btn-secondary mt-2">Back to List</a>