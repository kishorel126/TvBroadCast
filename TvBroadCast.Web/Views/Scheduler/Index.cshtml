@model IEnumerable<TvBroadCast.Domain.Entities.BroadCast>
@{
    ViewBag.Title = "My Broadcasts";
}
<h2>My Broadcasts</h2>
<a href="@Url.Action("Create")" class="btn btn-primary mb-2">Add New Broadcast</a>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Title</td>
                <td>@b.StartTime</td>
                <td>@b.EndTime</td>
                <td>@b.Status</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = b.Id })" class="btn btn-sm btn-info">Edit</a>
                    <a href="@Url.Action("Delete", new { id = b.Id })" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>