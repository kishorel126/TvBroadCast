@{
    ViewBag.Title = "My Broadcasts";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
        <h2 class="mb-2">📺 My Broadcasts</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">➕ Add New Broadcast</a>
    </div>

    <div id="result-message" class="mb-3"></div>

    <div class="table-responsive" id="broadcast-table-container">
        <table class="table table-bordered table-hover align-middle" id="broadcasts-table">
            <thead class="table-dark text-center">
                <tr>
                    <th>Title</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Status</th>
                    <th style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody class="text-center">
                <!-- Dynamic rows -->
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        function formatDateTime(dtString) {
            try {
                const dt = new Date(dtString);
                return dt.toLocaleString();
            } catch {
                return dtString;
            }
        }

        function showAlert(message, type = "success") {
            $("#result-message").html(`<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>`);
        }

        function loadBroadcasts() {
            $.ajax({
                url: '@Url.Action("GetMyBroadcasts", "Scheduler")',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    const tbody = $("#broadcasts-table tbody");
                    tbody.empty();
                    if (res.success && res.data && res.data.length > 0) {
                        res.data.forEach(function (b) {
                            tbody.append(`
                                <tr>
                                    <td>${b.title}</td>
                                    <td>${formatDateTime(b.startTime)}</td>
                                    <td>${formatDateTime(b.endTime)}</td>
                                    <td><span class="badge bg-${b.status === 'Approved' ? 'success' : b.status === 'Pending' ? 'warning' : 'danger'}">${b.status}</span></td>
                                    <td>
                                        <a href="@Url.Action("Edit", "Scheduler")?id=${b.id}" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                        <button class="btn btn-sm btn-outline-danger delete-btn" data-id="${b.id}">Delete</button>
                                    </td>
                                </tr>
                            `);
                        });
                    } else {
                        tbody.append('<tr><td colspan="5" class="text-center">No broadcasts found.</td></tr>');
                    }
                },
                error: function () {
                    showAlert("Error loading broadcasts.", "danger");
                }
            });
        }

        $(document).on('click', '.delete-btn', function (e) {
            e.preventDefault();
            const id = $(this).data('id');
            if (confirm('Are you sure you want to delete this broadcast?')) {
                $.ajax({
                    url: '@Url.Action("DeleteBroadcast", "Scheduler")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(id),
                    success: function (res) {
                        if (res.success) {
                            showAlert(res.message, "success");
                            loadBroadcasts();
                        } else {
                            showAlert(res.error || "Delete failed.", "danger");
                        }
                    },
                    error: function () {
                        showAlert("Delete request failed.", "danger");
                    }
                });
            }
        });

        $(document).ready(function () {
            loadBroadcasts();

            // SignalR Setup
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/broadcastHub")
                .build();

            connection.start().then(() => {
                console.log("SignalR connected to BroadcastHub");
            }).catch(err => {
                console.error("SignalR connection error:", err.toString());
            });

            connection.on("BroadcastUpdated", function () {
                console.log("BroadcastUpdated event received from SignalR");
                loadBroadcasts(); // Refresh automatically
            });
        });
    </script>
}
