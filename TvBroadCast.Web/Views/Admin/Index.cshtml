@using Microsoft.AspNetCore.Identity
@model List<IdentityUser>
@{
    ViewData["Title"] = "Admin Panel";
    var roles = ViewBag.Roles as List<IdentityRole>;
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<h2>Admin Panel - User Management</h2>
<div id="admin-message" class="alert alert-info" style="display:none;"></div>

<table class="table table-bordered" id="admin-users-table">
    <thead>
        <tr>
            <th>User Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Assign Role</th>
            <th>Remove Role</th>
            <th>Delete User</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr data-userid="@user.Id">
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    @if (userRoles != null && userRoles.ContainsKey(user.Id))
                    {
                        foreach (var role in userRoles[user.Id])
                        {
                            <span class="badge bg-success">@role</span>
                        }
                    }
                </td>
                <td>
                    <select class="admin-role-select form-select form-select-sm" style="width:130px; display:inline;">
                        @foreach (var role in roles)
                        {
                            <option value="@role.Name">@role.Name</option>
                        }
                    </select>
                    <button class="btn btn-primary btn-sm admin-add-role-btn">Add</button>
                </td>
                <td>
                    @if (userRoles != null && userRoles.ContainsKey(user.Id))
                    {
                        foreach (var role in userRoles[user.Id])
                        {
                            <button class="btn btn-warning btn-sm admin-remove-role-btn" data-rolename="@role">@role</button>
                        }
                    }
                </td>
                <td>
                    <button class="btn btn-danger btn-sm admin-delete-user-btn">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function() {

            function showMessage(msg) {
                $("#admin-message").text(msg).fadeIn().delay(2000).fadeOut();
            }

            // Add Role AJAX
            $(".admin-add-role-btn").on("click", function () {
                var row = $(this).closest('tr');
                var userId = row.data('userid');
                var roleName = row.find('.admin-role-select').val();
                $.ajax({
                    url: '@Url.Action("AddUserToRole", "Admin")',
                    method: 'POST',
                    data: { userId: userId, roleName: roleName },
                    success: function (result) {
                        showMessage("Role added successfully.");
                        location.reload(); // Reload to update roles
                    },
                    error: function () {
                        showMessage("Failed to add role.");
                    }
                });
            });

            // Remove Role AJAX
            $(".admin-remove-role-btn").on("click", function () {
                var row = $(this).closest('tr');
                var userId = row.data('userid');
                var roleName = $(this).data('rolename');
                $.ajax({
                    url: '@Url.Action("RemoveUserFromRole", "Admin")',
                    method: 'POST',
                    data: { userId: userId, roleName: roleName },
                    success: function (result) {
                        showMessage("Role removed successfully.");
                        location.reload();
                    },
                    error: function () {
                        showMessage("Failed to remove role.");
                    }
                });
            });

            // Delete User AJAX
            $(".admin-delete-user-btn").on("click", function () {
                if (!confirm("Are you sure you want to delete this user?")) return;
                var row = $(this).closest('tr');
                var userId = row.data('userid');
                $.ajax({
                    url: '@Url.Action("DeleteUser", "Admin")',
                    method: 'POST',
                    data: { userId: userId },
                    success: function (result) {
                        showMessage("User deleted successfully.");
                        row.fadeOut(500, function () { $(this).remove(); });
                    },
                    error: function () {
                        showMessage("Failed to delete user.");
                    }
                });
            });
        });
    </script>
}