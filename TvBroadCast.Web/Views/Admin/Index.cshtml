@using Microsoft.AspNetCore.Identity
@model List<IdentityUser>
@{
    ViewData["Title"] = "Admin Panel";
    var roles = ViewBag.Roles as List<IdentityRole>;
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<style>
    body {
        background: #f5f7fa;
    }

    h2 {
        margin-bottom: 25px;
        font-weight: 600;
        color: #333;
    }

    #admin-users-table {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

        #admin-users-table th {
            background-color: #343a40;
            color: white;
            text-align: center;
            vertical-align: middle;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        #admin-users-table td {
            vertical-align: middle;
        }

    .badge {
        margin-right: 4px;
    }

    .btn {
        margin: 2px 0;
    }

    #admin-message {
        margin-bottom: 20px;
        border-left: 6px solid #0d6efd;
        background: #e9f5ff;
        padding: 12px;
        font-weight: 500;
        border-radius: 5px;
    }

    .admin-role-select {
        margin-bottom: 5px;
    }

    .admin-add-role-btn, .admin-remove-role-btn, .admin-delete-user-btn {
        min-width: 80px;
    }

        .admin-remove-role-btn:hover,
        .admin-add-role-btn:hover,
        .admin-delete-user-btn:hover {
            opacity: 0.9;
        }

    @@media (max-width: 768px) {
        #admin-users-table th, #admin-users-table td

    {
        font-size: 0.875rem;
    }

    .admin-role-select {
        width: 100% !important;
    }

    }
</style>

<h2>Admin Panel - User Management</h2>
<div id="admin-message" class="alert alert-info" style="display:none;"></div>

<table class="table table-bordered table-striped" id="admin-users-table">
    <thead>
        <tr>
            <th>User Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Assign Role</th>
            <th>Remove Role</th>
            <th>Delete User</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr data-userid="@user.Id">
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    @if (userRoles != null && userRoles.ContainsKey(user.Id))
                    {
                        foreach (var role in userRoles[user.Id])
                        {
                            <span class="badge bg-success">@role</span>
                        }
                    }
                </td>
                <td>
                    <select class="admin-role-select form-select form-select-sm" style="width:130px; display:inline;">
                        @foreach (var role in roles)
                        {
                            <option value="@role.Name">@role.Name</option>
                        }
                    </select>
                    <button class="btn btn-primary btn-sm admin-add-role-btn">
                        <i class="bi bi-plus-circle"></i> Add
                    </button>
                </td>
                <td>
                    @if (userRoles != null && userRoles.ContainsKey(user.Id))
                    {
                        foreach (var role in userRoles[user.Id])
                        {
                            <button class="btn btn-warning btn-sm admin-remove-role-btn" data-rolename="@role">
                                <i class="bi bi-x-circle"></i> @role
                            </button>
                        }
                    }
                </td>
                <td>
                    <button class="btn btn-danger btn-sm admin-delete-user-btn">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>

    <script>
        $(function () {
            function showMessage(msg) {
                $("#admin-message").text(msg).fadeIn().delay(2000).fadeOut();
            }

            $(".admin-add-role-btn").on("click", function () {
                var row = $(this).closest('tr');
                var userId = row.data('userid');
                var roleName = row.find('.admin-role-select').val();
                $.ajax({
                    url: '@Url.Action("AddUserToRole", "Admin")',
                    method: 'POST',
                    data: { userId: userId, roleName: roleName },
                    success: function () {
                        showMessage("Role added successfully.");
                        location.reload();
                    },
                    error: function () {
                        showMessage("Failed to add role.");
                    }
                });
            });

            $(".admin-remove-role-btn").on("click", function () {
                var row = $(this).closest('tr');
                var userId = row.data('userid');
                var roleName = $(this).data('rolename');
                $.ajax({
                    url: '@Url.Action("RemoveUserFromRole", "Admin")',
                    method: 'POST',
                    data: { userId: userId, roleName: roleName },
                    success: function () {
                        showMessage("Role removed successfully.");
                        location.reload();
                    },
                    error: function () {
                        showMessage("Failed to remove role.");
                    }
                });
            });

            $(".admin-delete-user-btn").on("click", function () {
                if (!confirm("Are you sure you want to delete this user?")) return;
                var row = $(this).closest('tr');
                var userId = row.data('userid');
                $.ajax({
                    url: '@Url.Action("DeleteUser", "Admin")',
                    method: 'POST',
                    data: { userId: userId },
                    success: function () {
                        showMessage("User deleted successfully.");
                        row.fadeOut(500, function () { $(this).remove(); });
                    },
                    error: function () {
                        showMessage("Failed to delete user.");
                    }
                });
            });
        });
    </script>
}
